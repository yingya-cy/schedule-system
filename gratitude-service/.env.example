# 复制为 .env 后填写真实值；本文件不参与运行。
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=改成真实密码
DB_NAME=gratitude
PORT=5004
# 生成的图片/文件对外地址前缀（经 nginx 反代后使用）
PUBLIC_BASE=https://yingyacy.top/api/gratitude

# AI（留空则关闭所有 AI 功能：学生端不出评语，管理端简报页提示未配置）
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com/v1
AI_VISION_MODEL=deepseek-flash
AI_TEXT_MODEL=deepseek-flash
